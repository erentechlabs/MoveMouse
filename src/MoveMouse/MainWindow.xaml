<Window
    x:Class="MoveMouse.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MoveMouse.Converters"
    mc:Ignorable="d">

    <!--
        Note on styling: this window intentionally avoids named theme/static style
        resources (e.g. TitleTextBlockStyle, AccentButtonStyle, CardBackgroundFillColorDefaultBrush).
        In this project's unpackaged deployment model those named lookups are not
        reliably resolved at XAML load time and throw XamlParseException, even though
        the same key names are standard, documented WinUI 3 resources. Every control
        below instead either uses its implicit default style (no Style attribute, which
        resolves correctly via the framework's built-in per-type styles) or explicit,
        hardcoded property values. This renders identically and still adapts to the
        system light/dark theme because the built-in control styles themselves are
        theme-aware; only the few custom colors below are fixed.

        Layout: a single Start/Stop toggle button (color + icon + label all change
        together) replaces separate Start/Stop buttons. Every settings row (both
        Movement and Behavior) shares one consistent two-column grid — a flexible
        label on the left and a fixed-width control on the right, all right-edge
        aligned — so the whole card reads as one symmetric, evenly balanced list
        instead of a mix of stacked header/control pairs.
    -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter" />
            <converters:BoolToToggleButtonBrushConverter x:Key="BoolToToggleButtonBrushConverter" />

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#14808080" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#29808080" />
            <SolidColorBrush x:Key="DividerBrush" Color="#1F808080" />
            <SolidColorBrush x:Key="ErrorBannerBackgroundBrush" Color="#1FE81123" />
            <SolidColorBrush x:Key="ErrorBannerBorderBrush" Color="#55E81123" />
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="520"
                Margin="24"
                Spacing="20"
                HorizontalAlignment="Stretch">

                <!-- Header (centered for a balanced, single-column hero look) -->
                <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
                    <Image Source="Assets/AppIcon.png" Width="40" Height="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Move Mouse" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Keeps your PC awake with light, configurable cursor activity."
                        FontSize="12"
                        Opacity="0.8"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="360" />
                </StackPanel>

                <!-- Error / warning banner (hand-built instead of InfoBar, see styling note above) -->
                <Border
                    Background="{StaticResource ErrorBannerBackgroundBrush}"
                    BorderBrush="{StaticResource ErrorBannerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="Dismiss"
                            Command="{Binding DismissErrorCommand}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Status & control card (centered content for a calm, symmetric focal point) -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                    <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Ellipse
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Fill="{Binding IsRunning, Converter={StaticResource BoolToStatusBrushConverter}}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock
                                Text="{Binding StatusDetailText}"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="380" />
                            <TextBlock
                                Text="{Binding LastMovedText}"
                                FontSize="12"
                                Opacity="0.7"
                                HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Single Start/Stop toggle: one control, color/icon/label all reflect the same state -->
                        <Button
                            Command="{Binding ToggleJigglingCommand}"
                            Background="{Binding IsRunning, Converter={StaticResource BoolToToggleButtonBrushConverter}}"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Height="44"
                            CornerRadius="6"
                            AutomationProperties.Name="{Binding ToggleButtonText}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding ToggleButtonGlyph}" FontSize="14" />
                                <TextBlock Text="{Binding ToggleButtonText}" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Settings card: every row is the same two-column grid (flexible label, 160px control,
                     both columns right/left aligned identically) so Movement and Behavior read as one
                     evenly balanced list rather than a mix of header-above and label-beside controls. -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,0" />
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="MOVEMENT" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Jiggle interval (seconds)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumberBox
                                    Grid.Column="1"
                                    Width="176"
                                    MinWidth="0"
                                    Value="{Binding IntervalSeconds, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="3600"
                                    SmallChange="5"
                                    LargeChange="30"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="Jiggle interval in seconds" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Movement pattern" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="176"
                                    MinWidth="0"
                                    ItemsSource="{Binding MovementModes}"
                                    SelectedItem="{Binding SelectedMovementMode, Mode=TwoWay}"
                                    DisplayMemberPath="DisplayName"
                                    AutomationProperties.Name="Movement pattern" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Movement distance (pixels)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumberBox
                                    Grid.Column="1"
                                    Width="176"
                                    MinWidth="0"
                                    Value="{Binding MovementDistance, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="100"
                                    SmallChange="1"
                                    LargeChange="10"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="Movement distance in pixels" />
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,2,0,2" />

                            <TextBlock Text="BEHAVIOR" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Keep the display on while running" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding KeepDisplayOn, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Keep the display on while running" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Minimize to the system tray when closing the window" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Minimize to the system tray when closing the window" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start minimized to the system tray" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding StartMinimizedToTray, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Start minimized to the system tray" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start jiggling automatically when the app launches" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding AutoStartJigglingOnLaunch, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Start jiggling automatically when the app launches" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Launch Move Mouse when I sign in to Windows" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding LaunchAtWindowsStartup, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Launch Move Mouse when I sign in to Windows" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock
                    Text="Closing this window keeps Move Mouse running in the system tray (unless disabled above). Use the tray icon's Exit command to fully quit."
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="440" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
