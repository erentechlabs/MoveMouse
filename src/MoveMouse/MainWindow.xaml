<Window
    x:Class="MoveMouse.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MoveMouse.Converters"
    mc:Ignorable="d">

    <!--
        Note on styling: this window intentionally avoids named theme/static style
        resources (e.g. TitleTextBlockStyle, AccentButtonStyle, CardBackgroundFillColorDefaultBrush).
        In this project's unpackaged deployment model those named lookups are not
        reliably resolved at XAML load time and throw XamlParseException, even though
        the same key names are standard, documented WinUI 3 resources. Every control
        below instead either uses its implicit default style (no Style attribute, which
        resolves correctly via the framework's built-in per-type styles) or explicit,
        hardcoded property values. This renders identically and still adapts to the
        system light/dark theme because every built-in control's own default appearance
        is theme-aware; only the few custom accent/panel tint colors are fixed, and those
        are deliberately low-opacity so the window's Mica backdrop shows through (see
        MainWindow.xaml.cs) for a modern, translucent look in both themes.

        Layout: a wide, horizontal window following modern WinUI patterns — a fixed-width
        status/control sidebar on the left (always visible) next to a segmented pill tab
        bar ("Movement" / "Behavior") on the right, so settings are split into focused
        groups instead of one long scrolling list.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter" />
            <converters:BoolToToggleButtonBrushConverter x:Key="BoolToToggleButtonBrushConverter" />
            <converters:BoolToTabBrushConverter x:Key="BoolToTabBrushConverter" />

            <!-- Low-opacity panel tints: translucent enough that the window's Mica
                 backdrop remains visible through every card, in both light and dark theme. -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0F808080" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2E808080" />
            <SolidColorBrush x:Key="DividerBrush" Color="#22808080" />
            <SolidColorBrush x:Key="ErrorBannerBackgroundBrush" Color="#1FE81123" />
            <SolidColorBrush x:Key="ErrorBannerBorderBrush" Color="#55E81123" />
            <SolidColorBrush x:Key="WarningBannerBackgroundBrush" Color="#26FFB900" />
            <SolidColorBrush x:Key="WarningBannerBorderBrush" Color="#66FFB900" />
        </Grid.Resources>

        <Grid Margin="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon.png" Width="34" Height="34" />
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="Move Mouse" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Keeps your PC awake with light, configurable cursor activity."
                        FontSize="12"
                        Opacity="0.75" />
                </StackPanel>
            </StackPanel>

            <!-- Error / warning banner (hand-built instead of InfoBar, see styling note above) -->
            <Border
                Grid.Row="1"
                Background="{StaticResource ErrorBannerBackgroundBrush}"
                BorderBrush="{StaticResource ErrorBannerBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Content="Dismiss"
                        Command="{Binding DismissErrorCommand}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!--
                Scheduled-action warning banner: shown for the last 60 seconds
                before a scheduled shutdown/sleep runs. By the time this is
                visible, jiggling has already been stopped (see
                MainViewModel.OnScheduleWarningStarted). Cancel here skips
                today's run ("at a specific time") or turns the one-shot
                "after a countdown" schedule off entirely.
            -->
            <Border
                Grid.Row="2"
                Background="{StaticResource WarningBannerBackgroundBrush}"
                BorderBrush="{StaticResource WarningBannerBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Visibility="{Binding IsScheduleWarningActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding ScheduleWarningText}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelScheduledActionCommand}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!--
                Main: fixed-width status/control sidebar + tabbed settings.

                The sidebar card and the settings card are both placed in row 1 of
                this Grid (not nested grids of their own), so ordinary Grid
                auto-row-sizing makes row 1 exactly as tall as whichever of the two
                needs more space, and both cards, left at their default Stretch
                alignment, fill that row completely. That keeps the two cards the
                same height at all times, including when switching between the
                Movement (3 rows) and Behavior (5 rows) tabs. Row 0 holds only the
                centered segmented tab bar, above the settings card.
            -->
            <Grid Grid.Row="3" ColumnSpacing="20" RowSpacing="12" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Segmented pill tab bar: centered above the settings card -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button
                            Content="Movement"
                            Command="{Binding ShowMovementTabCommand}"
                            Background="{Binding IsMovementTabActive, Converter={StaticResource BoolToTabBrushConverter}}"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="18,8"
                            AutomationProperties.Name="Movement settings tab" />
                        <Button
                            Content="Behavior"
                            Command="{Binding ShowBehaviorTabCommand}"
                            Background="{Binding IsBehaviorTabActive, Converter={StaticResource BoolToTabBrushConverter}}"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="18,8"
                            AutomationProperties.Name="Behavior settings tab" />
                        <Button
                            Content="Schedule"
                            Command="{Binding ShowScheduleTabCommand}"
                            Background="{Binding IsScheduleTabActive, Converter={StaticResource BoolToTabBrushConverter}}"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="18,8"
                            AutomationProperties.Name="Schedule settings tab" />
                    </StackPanel>
                </Border>

                <!-- Sidebar: status + single Start/Stop toggle. Top-anchored and
                     sharing row 1 with the settings card (see comment above), so it
                     always matches that card's height instead of stretching down to
                     fill the whole remaining window height, and the toggle button
                     sits right under the status text instead of being stranded at
                     the bottom of an oversized card. -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">
                    <StackPanel Spacing="24" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    Fill="{Binding IsRunning, Converter={StaticResource BoolToStatusBrushConverter}}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock Text="{Binding StatusDetailText}" TextWrapping="Wrap" FontSize="13" />
                            <TextBlock Text="{Binding LastMovedText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Command="{Binding ToggleJigglingCommand}"
                            Background="{Binding IsRunning, Converter={StaticResource BoolToToggleButtonBrushConverter}}"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Height="42"
                            CornerRadius="6"
                            AutomationProperties.Name="{Binding ToggleButtonText}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding ToggleButtonGlyph}" FontSize="13" />
                                <TextBlock Text="{Binding ToggleButtonText}" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Tab content: both panels occupy the same cell; only the active one is visible -->
                <Grid Grid.Row="1" Grid.Column="1">
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Visibility="{Binding IsMovementTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="16" VerticalAlignment="Top">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Jiggle interval (seconds)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumberBox
                                    Grid.Column="1"
                                    Width="176"
                                    MinWidth="0"
                                    Value="{Binding IntervalSeconds, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="3600"
                                    SmallChange="5"
                                    LargeChange="30"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="Jiggle interval in seconds" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Movement pattern" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="176"
                                    MinWidth="0"
                                    ItemsSource="{Binding MovementModes}"
                                    SelectedItem="{Binding SelectedMovementMode, Mode=TwoWay}"
                                    DisplayMemberPath="DisplayName"
                                    AutomationProperties.Name="Movement pattern" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Movement distance (pixels)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumberBox
                                    Grid.Column="1"
                                    Width="176"
                                    MinWidth="0"
                                    Value="{Binding MovementDistance, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="100"
                                    SmallChange="1"
                                    LargeChange="10"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="Movement distance in pixels" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Visibility="{Binding IsBehaviorTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14" VerticalAlignment="Top">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Keep the display on while running" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding KeepDisplayOn, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Keep the display on while running" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Minimize to the system tray when closing the window" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Minimize to the system tray when closing the window" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start minimized to the system tray" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding StartMinimizedToTray, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Start minimized to the system tray" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start jiggling automatically when the app launches" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding AutoStartJigglingOnLaunch, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Start jiggling automatically when the app launches" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Launch Move Mouse when I sign in to Windows" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding LaunchAtWindowsStartup, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Launch Move Mouse when I sign in to Windows" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Visibility="{Binding IsScheduleTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="14" VerticalAlignment="Top">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Enable scheduled shutdown or sleep" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{Binding ScheduledActionEnabled, Mode=TwoWay}"
                                    OnContent=""
                                    OffContent=""
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Enable scheduled shutdown or sleep" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Action" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="176"
                                    MinWidth="0"
                                    ItemsSource="{Binding ScheduledActionTypes}"
                                    SelectedItem="{Binding SelectedScheduledActionType, Mode=TwoWay}"
                                    DisplayMemberPath="DisplayName"
                                    AutomationProperties.Name="Scheduled action" />
                            </Grid>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Run" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="176"
                                    MinWidth="0"
                                    ItemsSource="{Binding ScheduledActionTriggerModes}"
                                    SelectedItem="{Binding SelectedScheduledActionTriggerMode, Mode=TwoWay}"
                                    DisplayMemberPath="DisplayName"
                                    AutomationProperties.Name="Schedule trigger mode" />
                            </Grid>

                            <Grid
                                ColumnSpacing="16"
                                Visibility="{Binding IsAtSpecificTimeMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Time of day" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <TimePicker
                                    Grid.Column="1"
                                    Time="{Binding ScheduledActionTime, Mode=TwoWay}"
                                    AutomationProperties.Name="Scheduled time of day" />
                            </Grid>

                            <Grid
                                ColumnSpacing="16"
                                Visibility="{Binding IsAfterCountdownMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Countdown (minutes)" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumberBox
                                    Grid.Column="1"
                                    Width="176"
                                    MinWidth="0"
                                    Value="{Binding ScheduledActionCountdownMinutes, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="1440"
                                    SmallChange="5"
                                    LargeChange="30"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="Countdown in minutes" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,2" />

                            <TextBlock
                                Text="{Binding ScheduleStatusText}"
                                FontSize="13"
                                Opacity="0.85"
                                TextWrapping="Wrap"
                                AutomationProperties.Name="Schedule status" />

                            <TextBlock
                                Text="Move Mouse stops jiggling and shows a 60-second warning (with a Cancel option) before the scheduled action runs. The schedule only runs while Move Mouse is open, including minimized to the system tray."
                                FontSize="11"
                                Opacity="0.65"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <TextBlock
                Grid.Row="4"
                Text="Closing this window keeps Move Mouse running in the system tray (unless disabled in Behavior). Use the tray icon's Exit command to fully quit."
                FontSize="11"
                Opacity="0.65"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                TextAlignment="Center" />
        </Grid>
    </Grid>
</Window>
